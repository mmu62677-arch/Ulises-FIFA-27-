<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>FC 27 3D - Fútbol Pro</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0; width: 100%; height: 100%; overflow: hidden;
      background: #060c14; color: white; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      touch-action: none; user-select: none;
    }
    #game { position: fixed; inset: 0; }
    canvas { display: block; width: 100%; height: 100%; }

    /* HUD Overlay */
    #hud {
      position: fixed; top: 12px; left: 50%; transform: translateX(-50%);
      display: flex; align-items: center; gap: 14px; padding: 8px 20px;
      background: rgba(6, 16, 29, 0.85); backdrop-filter: blur(8px);
      border: 1px solid rgba(84, 224, 161, 0.3); border-radius: 30px;
      z-index: 3; font-weight: 900; text-shadow: 0 2px 4px #000;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    .team { font-size: clamp(14px, 2vw, 18px); letter-spacing: 1px; }
    #score {
      font-size: clamp(20px, 3.5vw, 28px); background: #07111c;
      padding: 4px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);
      color: #6dffb1;
    }
    #clock { font-size: clamp(14px, 2vw, 18px); min-width: 50px; text-align: center; color: #ffca3a; }

    /* Radar Minimap */
    #minimap-container {
      position: fixed; top: 12px; left: 16px; z-index: 3;
      width: 120px; height: 80px; background: rgba(8, 25, 18, 0.75);
      border: 2px solid rgba(255,255,255,0.3); border-radius: 8px;
      overflow: hidden; backdrop-filter: blur(4px);
    }
    #minimap { width: 100%; height: 100%; }

    /* Sound Toggle & Pause */
    #soundBtn {
      position: fixed; top: 12px; right: 60px; z-index: 5;
      background: rgba(33, 57, 79, 0.8); border: 1px solid rgba(255,255,255,0.2);
      color: white; border-radius: 50%; width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 16px; backdrop-filter: blur(4px);
    }

    #pauseBtn {
      position: fixed; top: 12px; right: 14px; z-index: 5;
      background: rgba(33, 57, 79, 0.8); border: 1px solid rgba(255,255,255,0.2);
      color: white; border-radius: 50%; width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-weight: bold; backdrop-filter: blur(4px);
    }

    /* Menus & Panels */
    #menu, #pause, #result {
      position: fixed; inset: 0; z-index: 10; display: flex;
      align-items: center; justify-content: center;
      background: radial-gradient(circle at center, rgba(13, 27, 42, 0.92), rgba(4, 10, 18, 0.98));
      padding: 20px; backdrop-filter: blur(10px);
    }
    .panel {
      width: min(460px, 92vw); background: #0d1b2a;
      border: 2px solid #31d68b; border-radius: 24px; padding: 30px;
      text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.8);
    }
    h1 {
      font-size: clamp(34px, 7vw, 52px); margin: 0 0 4px; color: #54e0a1;
      text-shadow: 0 0 15px rgba(84, 224, 161, 0.4); letter-spacing: 2px;
    }
    h2 { margin-top: 0; color: #54e0a1; }
    p { color: #a2b9d0; line-height: 1.5; margin-bottom: 20px; }
    label { display: block; text-align: left; font-size: 12px; font-weight: bold; color: #54e0a1; margin-top: 10px; }
    button, select {
      border: 0; border-radius: 12px; padding: 14px 20px; font-weight: 800; font-size: 15px; outline: none;
    }
    button {
      background: linear-gradient(135deg, #31d68b, #1bb06a); color: #052719;
      cursor: pointer; margin: 8px 4px; transition: transform 0.1s, box-shadow 0.2s;
      box-shadow: 0 4px 15px rgba(49, 214, 139, 0.3);
    }
    button:active { transform: scale(0.96); }
    button.secondary { background: #27445c; color: white; box-shadow: none; }
